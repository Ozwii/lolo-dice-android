[
  { "id": "si_01", "veredicto": "SI", "reaccion": "feliz", "texto": "¡Dale sin miedo, Lolo aprueba!", "es_club": false },
  { "id": "si_02", "veredicto": "SI", "reaccion": "feliz", "texto": "Hoy sí toca, no lo pienses tanto.", "es_club": false },
  { "id": "si_03", "veredicto": "SI", "reaccion": "feliz", "texto": "Lolo dice que sí, ve por ello.", "es_club": false },
  { "id": "si_04", "veredicto": "SI", "reaccion": "sorpresa", "texto": "¡De una! Hoy es tu día.", "es_club": false },
  { "id": "si_05", "veredicto": "SI", "reaccion": "feliz", "texto": "Sí rotundo, pero con actitud.", "es_club": false },
  { "id": "si_06", "veredicto": "SI", "reaccion": "sorpresa", "texto": "¡Hazlo ya antes de que te arrepientas!", "es_club": false },
  { "id": "si_07", "veredicto": "SI", "reaccion": "feliz", "texto": "Lolo está a favor, cero dudas.", "es_club": false },
  { "id": "si_08", "veredicto": "SI", "reaccion": "mareado", "texto": "Sí, y si sale mal le echamos la culpa al ajolote.", "es_club": false },
  { "id": "si_09", "veredicto": "SI", "reaccion": "feliz", "texto": "¡Claro que sí! Se tenía que decir.", "es_club": false },
  { "id": "si_10", "veredicto": "SI", "reaccion": "feliz", "texto": "Luz verde total desde el estanque.", "es_club": false },
  { "id": "si_11", "veredicto": "SI", "reaccion": "feliz", "texto": "Sí, pero hazlo con estilo.", "es_club": false },
  { "id": "si_12", "veredicto": "SI", "reaccion": "sorpresa", "texto": "Hoy la vibra dice que sí.", "es_club": false },
  { "id": "si_13", "veredicto": "SI", "reaccion": "sorpresa", "texto": "¡Vamos! Lolo ya se emocionó.", "es_club": false },
  { "id": "si_14", "veredicto": "SI", "reaccion": "feliz", "texto": "Sí, sin pensarlo dos veces.", "es_club": false },

  { "id": "si_sarc_01", "veredicto": "SI", "reaccion": "feliz", "tono": "atrevido", "texto": "Sí, pero luego no digas que Lolo te empujó.", "es_club": false },
  { "id": "si_sarc_02", "veredicto": "SI", "reaccion": "sorpresa", "tono": "sarcastico", "texto": "De una. Total, el drama es gratis.", "es_club": false },
  { "id": "si_sarc_03", "veredicto": "SI", "reaccion": "feliz", "tono": "atrevido", "texto": "Sí, hazlo y que el universo haga malabares.", "es_club": false },
  { "id": "si_sarc_04", "veredicto": "SI", "reaccion": "sorpresa", "tono": "sarcastico", "texto": "¡Claro! ¿Qué es lo peor que podría pasar… además de todo?", "es_club": false },
  { "id": "si_sarc_05", "veredicto": "SI", "reaccion": "feliz", "tono": "sarcastico", "texto": "Sí, porque pensar demasiado nunca fue tu fuerte.", "es_club": false },
  { "id": "si_sarc_06", "veredicto": "SI", "reaccion": "sorpresa", "tono": "atrevido", "texto": "Dale, hoy se vive peligrosamente desde el sofá.", "es_club": false },

  { "id": "no_01", "veredicto": "NO", "reaccion": "enojado", "texto": "Ni en tus mejores sueños.", "es_club": false },
  { "id": "no_02", "veredicto": "NO", "reaccion": "dudoso", "texto": "Lolo dice que hoy mejor no.", "es_club": false },
  { "id": "no_03", "veredicto": "NO", "reaccion": "enojado", "texto": "¡Paso! Hoy no es el día.", "es_club": false },
  { "id": "no_04", "veredicto": "NO", "reaccion": "mareado", "texto": "No lo hagas, te va a dar pereza.", "es_club": false },
  { "id": "no_05", "veredicto": "NO", "reaccion": "enojado", "texto": "Hoy Lolo está en modo negativo.", "es_club": false },
  { "id": "no_06", "veredicto": "NO", "reaccion": "dudoso", "texto": "No, mejor respira hondo y espera.", "es_club": false },
  { "id": "no_07", "veredicto": "NO", "reaccion": "enojado", "texto": "¡Alto ahí! Lolo no lo recomienda.", "es_club": false },
  { "id": "no_08", "veredicto": "NO", "reaccion": "dudoso", "texto": "No, guarda esa energía para otra cosa.", "es_club": false },
  { "id": "no_09", "veredicto": "NO", "reaccion": "enojado", "texto": "Rotundamente no. Siguiente pregunta.", "es_club": false },
  { "id": "no_10", "veredicto": "NO", "reaccion": "mareado", "texto": "Lolo sacudió la cabeza y dijo que no.", "es_club": false },
  { "id": "no_11", "veredicto": "NO", "reaccion": "dudoso", "texto": "Hoy no, mañana vemos qué pasa.", "es_club": false },
  { "id": "no_12", "veredicto": "NO", "reaccion": "enojado", "texto": "No, suena a problema gratuito.", "es_club": false },
  { "id": "no_13", "veredicto": "NO", "reaccion": "enojado", "texto": "¡Ni lo intentes! Lolo te cuida.", "es_club": false },
  { "id": "no_14", "veredicto": "NO", "reaccion": "dudoso", "texto": "No esta vez, campeón.", "es_club": false },

  { "id": "no_sarc_01", "veredicto": "NO", "reaccion": "enojado", "tono": "sarcastico", "texto": "No, cariño, hoy la lógica está de vacaciones.", "es_club": false },
  { "id": "no_sarc_02", "veredicto": "NO", "reaccion": "dudoso", "tono": "sarcastico", "texto": "Ni en broma. Lolo tiene estándares.", "es_club": false },
  { "id": "no_sarc_03", "veredicto": "NO", "reaccion": "enojado", "tono": "atrevido", "texto": "No, pero suena a excelente anécdota para otro día.", "es_club": false },
  { "id": "no_sarc_04", "veredicto": "NO", "reaccion": "dudoso", "tono": "sarcastico", "texto": "Hoy no. Tu yo del futuro ya te lo agradeció.", "es_club": false },
  { "id": "no_sarc_05", "veredicto": "NO", "reaccion": "mareado", "tono": "sarcastico", "texto": "No, qué flojera explicar después.", "es_club": false },
  { "id": "no_sarc_06", "veredicto": "NO", "reaccion": "enojado", "tono": "atrevido", "texto": "Lolo dice que no… y no está a discusión.", "es_club": false },
  { "id": "no_sarc_07", "veredicto": "NO", "reaccion": "dudoso", "tono": "sarcastico", "texto": "No, mejor finge demencia un ratito más.", "es_club": false },

  { "id": "talvez_01", "veredicto": "TAL_VEZ", "reaccion": "mareado", "texto": "50 y 50… agítame más fuerte.", "es_club": false },
  { "id": "talvez_02", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "texto": "Hoy ando indeciso, tú decides.", "es_club": false },
  { "id": "talvez_03", "veredicto": "TAL_VEZ", "reaccion": "mareado", "texto": "Tal vez sí, tal vez no, tal vez una siesta.", "es_club": false },
  { "id": "talvez_04", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "texto": "Depende de cuánta hambre o sueño tengas.", "es_club": false },
  { "id": "talvez_05", "veredicto": "TAL_VEZ", "reaccion": "mareado", "texto": "Lolo se mareó y no vio claro.", "es_club": false },
  { "id": "talvez_06", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "texto": "Puede ser… pero no me comprometas.", "es_club": false },
  { "id": "talvez_07", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "texto": "Hoy está nublado el pronóstico de Lolo.", "es_club": false },
  { "id": "talvez_08", "veredicto": "TAL_VEZ", "reaccion": "mareado", "texto": "Tal vez, si lo haces rápido.", "es_club": false },
  { "id": "talvez_09", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "texto": "Mmm… déjame pensarlo otro rato.", "es_club": false },
  { "id": "talvez_10", "veredicto": "TAL_VEZ", "reaccion": "mareado", "texto": "Mitad y mitad, como buen ajolote.", "es_club": false },

  { "id": "talvez_sarc_01", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "tono": "sarcastico", "texto": "Tal vez, si te convence más tu orgullo que tu sentido común.", "es_club": false },
  { "id": "talvez_sarc_02", "veredicto": "TAL_VEZ", "reaccion": "mareado", "tono": "atrevido", "texto": "Depende: ¿vas a hacer caso o solo querías que te diera la razón?", "es_club": false },
  { "id": "talvez_sarc_03", "veredicto": "TAL_VEZ", "reaccion": "dudoso", "tono": "sarcastico", "texto": "Tal vez sí, tal vez no… ¿a quién le importa realmente?", "es_club": false },
  { "id": "talvez_sarc_04", "veredicto": "TAL_VEZ", "reaccion": "mareado", "tono": "sarcastico", "texto": "50 y 50. Lolo ya cobró su emoción por hoy.", "es_club": false },

  { "id": "esp_01", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "¡Alerta cósmica! Lolo dice que sí, pero con estilo.", "es_club": true },
  { "id": "esp_02", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "¡Plot twist! Haz exactamente lo contrario.", "es_club": true },
  { "id": "esp_03", "veredicto": "ESPECIAL", "reaccion": "mareado", "texto": "Lolo entró en trance: ¡sí, pero en secreto!", "es_club": true },
  { "id": "esp_04", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "Veredicto legendario: ¡hoy se conquista el mundo!", "es_club": true },
  { "id": "esp_05", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "¡Sacudida crítica! Solo si te ríes primero.", "es_club": true },
  { "id": "esp_06", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "Lolo consultó al cosmos y dijo: ¡chisme o acción!", "es_club": true },
  { "id": "esp_07", "veredicto": "ESPECIAL", "reaccion": "enojado", "texto": "Modo drama activado: ¡sí, pero con mucho suspenso!", "es_club": true },
  { "id": "esp_08", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "¡Hallazgo raro! Lolo aprueba con aplausos.", "es_club": true },
  { "id": "esp_09", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "texto": "La profecía del ajolote dice: ¡hazlo y cuenta!", "es_club": true },
  { "id": "esp_10", "veredicto": "ESPECIAL", "reaccion": "mareado", "texto": "¡Racha mística! Hoy Lolo no falla (o sí).", "es_club": true },

  { "id": "esp_sarc_01", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "tono": "atrevido", "texto": "¡Veredicto picante! Hazlo, pero actúa como si fuera idea ajena.", "es_club": true },
  { "id": "esp_sarc_02", "veredicto": "ESPECIAL", "reaccion": "mareado", "tono": "sarcastico", "texto": "Lolo revisó el historial y dijo: ‘Otra vez tú’.", "es_club": true },
  { "id": "esp_sarc_03", "veredicto": "ESPECIAL", "reaccion": "sorpresa", "tono": "sarcastico", "texto": "¡Plot twist sarcástico! Sí… pero solo si finges sorpresa.", "es_club": true }
]
